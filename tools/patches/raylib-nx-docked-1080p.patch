+// Rendered area of the 1920x1080 window buffers (1280x720 handheld, all of it docked), shown through the window crop;
+// the screen stays 1280x720 units
+void NxSetRenderSize(int width, int height)
+{
+    if (!CORE.Window.ready || (width == CORE.Window.render.width && height == CORE.Window.render.height)) return;
+    nwindowSetCrop(platform.gbmSurface, 0, 1080 - height, width, 1080);  // GL rows run bottom-up in the buffer
+    CORE.Window.display.width = width;
+    CORE.Window.display.height = height;
+    CORE.Window.currentFbo.width = width;
+    CORE.Window.currentFbo.height = height;
+    CORE.Window.screenScale = MatrixScale((float)width/CORE.Window.screen.width, (float)height/CORE.Window.screen.height, 1.0f);
+    SetupViewport(width, height);
+    TRACELOG(LOG_INFO, "DISPLAY: render size %i x %i", width, height);
+}
