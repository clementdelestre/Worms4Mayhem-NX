+// Single Joy-Con held sideways: map face buttons by their on-screen position, SL/SR to L/R, its stick to the left stick
+static u64 NxSideways(u64 k, u64 a, u64 b, u64 x, u64 y, u64 sl, u64 sr, u64 plus, u64 stick)
+{
+    return ((k & a)? HidNpadButton_A : 0) | ((k & b)? HidNpadButton_B : 0) | ((k & x)? HidNpadButton_X : 0) | ((k & y)? HidNpadButton_Y : 0) |
+           ((k & sl)? HidNpadButton_L : 0) | ((k & sr)? HidNpadButton_R : 0) | ((k & plus)? HidNpadButton_Plus : 0) | ((k & stick)? HidNpadButton_StickL : 0);
+}
